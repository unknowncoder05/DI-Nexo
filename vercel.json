{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/nexo/browser",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/documentacion",
      "destination": "/documentacion/index.html"
    },
    {
      "source": "/documentacion/",
      "destination": "/documentacion/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ngsw.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
