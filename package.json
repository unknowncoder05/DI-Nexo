{
  "name": "nexo-gestion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0 <13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "concurrently -k -n api,angular \"npm:server\" \"ng serve --host 0.0.0.0\"",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "ng build",
    "preview": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "docs": "compodoc -p tsconfig.app.json -d documentation --disableRoutesGraph --disableGraph",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "check": "npm test && npm run build && npm run docs",
    "build:sandbox": "ng build --configuration production,sandbox",
    "infra": "node --env-file-if-exists=.env scripts/terraform.mjs",
    "db:setup": "node --env-file=.env scripts/database.mjs",
    "db:plan": "node --env-file=.env scripts/database.mjs --dry-run",
    "db:users": "node --env-file=.env scripts/provision-users.mjs",
    "db:verify": "node --env-file=.env scripts/verify-database.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/service-worker": "22.2.2",
    "@ionic/angular": "9.0.7",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "ionicons": "8.1.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@compodoc/compodoc": "2.0.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "concurrently": "10.0.6",
    "lighthouse": "13.5.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3"
  }
}
