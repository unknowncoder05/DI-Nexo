{
  "name": "nexo-gestion", "version": "1.0.0", "private": true, "type": "module",
  "engines": {"node": ">=22.12.0 <23"},
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "concurrently -k -n api,angular \"npm:server\" \"ng serve --host 0.0.0.0\"",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "ng build",
    "preview": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "docs": "compodoc -p tsconfig.app.json -d documentation --disableRoutesGraph --disableGraph",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "check": "npm test && npm run build && npm run docs"
  },
  "dependencies": {
    "@angular/common": "~20.3.0", "@angular/compiler": "~20.3.0", "@angular/core": "~20.3.0", "@angular/forms": "~20.3.0", "@angular/platform-browser": "~20.3.0", "@angular/router": "~20.3.0", "@angular/service-worker": "~20.3.0",
    "@ionic/angular": "^8.7.0", "ionicons": "^7.4.0", "rxjs": "~7.8.2", "tslib": "^2.8.1", "zone.js": "~0.15.1",
    "chart.js": "^4.5.0", "jspdf": "^3.0.3", "jspdf-autotable": "^5.0.2", "express": "^5.1.0", "cookie-parser": "^1.4.7", "jose": "^6.1.0", "helmet": "^8.1.0", "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {"@angular/build": "~20.3.0", "@angular/cli": "~20.3.0", "@angular/compiler-cli": "~20.3.0", "typescript": "~5.9.2", "@compodoc/compodoc": "^1.1.31", "@playwright/test": "^1.56.0", "concurrently": "^9.2.1", "lighthouse": "^12.8.2", "supertest": "^7.1.4"}
}
